---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, localeInfo, localePath, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  page?: '' | 'learn';
  title: string;
  description: string;
}
const { lang, page = '', title, description } = Astro.props;
const d = t(lang);
const site = Astro.site ?? new URL('https://vizcachas-landing.vercel.app');
const canonical = new URL(localePath(lang, page), site).href;
const ogImage = new URL('/og.png', site).href;
---

<!doctype html>
<html lang={localeInfo[lang].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={localeInfo[l].tag} href={new URL(localePath(l, page), site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', page), site).href} />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <meta name="theme-color" content="#f8f8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={localeInfo[lang].tag.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
    />

    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('theme');
          var dark = s ? s === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-paper"
      >{d.nav.skip}</a
    >
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import { APP_URL } from '../i18n';
      // The app's date picker starts near the current date (min was 2026-11-17 when this was written).
      // Scenario links are written with example dates
      // (Nov 2026); move them forward by whole synodic months so they stay valid and keep the same
      // Sun phase. Applied in the browser, so it works without rebuilding the site.
      const SYNODIC_MS = 29.530589 * 86400e3;
      const HOUR = 3600e3;
      const minStart = Date.now() + 24 * HOUR;
      const iso = (ms: number) => new Date(Math.round(ms / HOUR) * HOUR).toISOString().slice(0, 16) + 'Z';
      document.querySelectorAll<HTMLAnchorElement>(`a[href^="${APP_URL}"]`).forEach((a) => {
        const url = new URL(a.href);
        const t = url.searchParams.get('t');
        if (!t) return;
        const base = Date.parse(t);
        if (Number.isNaN(base) || base >= minStart) return;
        const shift = Math.ceil((minStart - base) / SYNODIC_MS) * SYNODIC_MS;
        url.searchParams.set('t', iso(base + shift));
        const c = url.searchParams.get('c');
        if (c) {
          url.searchParams.set('c', c.split(',').map((s) => {
            const [site, when] = s.split('@');
            return `${site}@${iso(Date.parse(when) + shift)}`;
          }).join(','));
        }
        a.href = url.toString();
      });
    </script>
  </body>
</html>
