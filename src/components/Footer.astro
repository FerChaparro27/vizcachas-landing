---
import { t, appUrl, REPO_URL, CHALLENGE_URL, type Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1fr_auto]">
    <div class="flex items-start gap-4">
      <img src="/assets/logo-vizcachas.svg" alt="" width="44" height="44" class="h-11 w-11 rounded-full border border-line bg-white p-0.5 dark:invert" />
      <div>
        <p class="font-serif text-lg font-semibold">Lunar Landing Site Navigator</p>
        <p class="text-sm text-muted">{d.footer.tagline}</p>
        <p class="mt-3 text-xs text-muted">© 2026 Vizcachas fuera de órbita · MIT License · {d.footer.event}</p>
        {lang !== 'en' && lang !== 'es' && <p class="mt-1 text-xs text-muted">{d.footer.translationNote}</p>}
      </div>
    </div>
    <div class="flex flex-col items-start gap-4 md:items-end">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <li><a class="underline-offset-4 hover:underline" href={appUrl(lang)}>{d.footer.app} ↗</a></li>
        <li><a class="underline-offset-4 hover:underline" href={REPO_URL}>{d.footer.repo} ↗</a></li>
        <li><a class="underline-offset-4 hover:underline" href={CHALLENGE_URL}>{d.footer.challenge} ↗</a></li>
      </ul>
      <a href={CHALLENGE_URL} class="rounded-md bg-[#0b1020] px-3 py-2 ring-1 ring-line">
        <img src="/assets/nasa-space-apps.png" alt="NASA Space Apps Challenge" width="128" height="51" class="h-11 w-auto" loading="lazy" />
      </a>
    </div>
  </div>
</footer>
