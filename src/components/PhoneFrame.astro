---
/** Simple phone mockup around a screenshot or a recorded loop (HTML/CSS only). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FeatureVideo from './FeatureVideo.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Name of a loop in public/videos; when set, it replaces the still image. */
  video?: string;
  /** CSS width of the phone (default: up to 250px). */
  width?: string;
  class?: string;
}
const { src, alt, video, width, class: cls } = Astro.props;
---

<div class:list={['phone', cls]} style={width ? `--phone-w: ${width}` : undefined}>
  <div class="phone-body">
    <span class="phone-notch" aria-hidden="true"></span>
    {
      video ? (
        <FeatureVideo name={video} label={alt} width={src.width / 2} height={src.height / 2} class="phone-screen" />
      ) : (
        <Image src={src} alt={alt} widths={[260, 520]} sizes="260px" class="phone-screen" />
      )
    }
  </div>
</div>

<style>
  .phone {
    width: var(--phone-w, min(100%, 250px));
    transform: rotate(-4deg);
    transition: transform 0.5s ease;
  }
  .phone:hover { transform: rotate(0deg) translateY(-4px); }
  .phone-body {
    position: relative;
    border-radius: 16% / 7.5%;
    padding: 4%;
    background: linear-gradient(145deg, #2a3147, #0b1020 55%, #1a2033);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 30px 60px -20px rgba(11, 16, 32, 0.55),
      0 12px 24px -12px rgba(11, 16, 32, 0.4);
  }
  .phone-notch {
    position: absolute;
    top: 4.2%;
    left: 50%;
    z-index: 1;
    width: 30%;
    height: 2.6%;
    transform: translateX(-50%);
    border-radius: 9999px;
    background: #05070d;
  }
  .phone :global(.phone-screen) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12% / 5.5%;
  }
  @media (prefers-reduced-motion: reduce) {
    .phone, .phone:hover { transition: none; }
  }
</style>
