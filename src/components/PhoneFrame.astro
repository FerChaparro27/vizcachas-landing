---
/** Simple phone mockup around a screenshot (HTML/CSS only). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}
const { src, alt, class: cls } = Astro.props;
---

<div class:list={['phone group/phone', cls]}>
  <div class="phone-body">
    <span class="phone-notch" aria-hidden="true"></span>
    <Image src={src} alt={alt} widths={[260, 520]} sizes="260px" class="phone-screen" />
  </div>
</div>

<style>
  .phone {
    width: min(100%, 250px);
    transform: rotate(-4deg);
    transition: transform 0.5s ease;
  }
  .phone:hover { transform: rotate(0deg) translateY(-4px); }
  .phone-body {
    position: relative;
    border-radius: 2.4rem;
    padding: 0.6rem;
    background: linear-gradient(145deg, #2a3147, #0b1020 55%, #1a2033);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 30px 60px -20px rgba(11, 16, 32, 0.55),
      0 12px 24px -12px rgba(11, 16, 32, 0.4);
  }
  .phone-notch {
    position: absolute;
    top: 1rem;
    left: 50%;
    z-index: 1;
    width: 32%;
    height: 1.1rem;
    transform: translateX(-50%);
    border-radius: 9999px;
    background: #05070d;
  }
  .phone-screen {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.9rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .phone, .phone:hover { transition: none; }
  }
</style>
