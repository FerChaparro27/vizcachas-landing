---
import { locales, localeInfo, localePath, t, appUrl, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  page: '' | 'learn';
}
const { lang, page } = Astro.props;
const d = t(lang);
const home = localePath(lang);
// In-page anchors on the home page. The learn module is a separate page, shown as its own button.
const links = [
  { href: `${home}#problem`, label: d.nav.problem },
  { href: `${home}#showcase`, label: d.nav.showcase },
  { href: `${home}#solution`, label: d.nav.solution },
  { href: `${home}#team`, label: d.nav.team },
];
const learnHref = localePath(lang, 'learn');
const bookIcon = 'M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5zM4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5';
---

<!-- Floating pill navigation (Shadowmap-style): sticky, inset from the edges. -->
<header class="sticky top-3 z-40 px-3 sm:px-4">
  <div
    class="mx-auto flex h-14 max-w-7xl items-center gap-2 rounded-full border border-line bg-surface/90 pr-2 pl-3 shadow-lg shadow-black/5 backdrop-blur supports-[backdrop-filter]:bg-surface/75 sm:pl-4"
  >
    <a href={home} class="flex shrink-0 items-center gap-2.5" aria-label={d.nav.home}>
      <img src="/assets/logo-vizcachas.svg" alt="" width="32" height="32" class="h-8 w-8 rounded-full border border-line bg-white p-0.5 dark:invert" />
      <span class="hidden font-serif text-[1.02rem] font-semibold leading-tight sm:block">Lunar Landing Site Navigator</span>
    </a>

    <nav class="ml-auto hidden xl:block" aria-label="Main">
      <ul class="flex items-center gap-0.5 text-sm">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="rounded-full px-3 py-1.5 whitespace-nowrap text-muted transition-colors hover:bg-surface-2 hover:text-ink">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 xl:ml-1">
      <details class="lang-menu relative">
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-full px-2.5 py-1.5 text-sm text-muted hover:bg-surface-2 hover:text-ink"
          aria-label={d.nav.language}
        >
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"></path>
          </svg>
          <span class="font-mono text-xs uppercase">{lang}</span>
        </summary>
        <ul class="absolute right-0 mt-3 w-44 overflow-hidden rounded-xl border border-line bg-surface py-1 text-sm shadow-lg">
          {
            locales.map((l) => (
              <li>
                <a
                  href={localePath(l, page)}
                  hreflang={localeInfo[l].tag}
                  lang={localeInfo[l].tag}
                  class:list={['flex justify-between px-3 py-2 hover:bg-surface-2', l === lang && 'font-semibold']}
                  aria-current={l === lang ? 'true' : undefined}
                >
                  {localeInfo[l].label}
                  <span class="font-mono text-xs uppercase text-muted">{l}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <button
        id="theme-toggle"
        type="button"
        class="rounded-full p-2 text-muted hover:bg-surface-2 hover:text-ink"
        aria-label={d.nav.theme}
        title={d.nav.theme}
      >
        <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
        </svg>
        <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>

      <details class="mobile-menu relative xl:hidden">
        <summary class="cursor-pointer list-none rounded-full p-2 text-muted hover:bg-surface-2 hover:text-ink" aria-label={d.nav.menu}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul class="absolute right-0 mt-3 w-56 overflow-hidden rounded-xl border border-line bg-surface py-1 text-sm shadow-lg">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="block px-3 py-2 hover:bg-surface-2">{l.label}</a>
              </li>
            ))
          }
          <li class="mt-1 border-t border-line pt-1">
            <a href={learnHref} class="flex items-center gap-2 px-3 py-2 font-medium hover:bg-surface-2">
              <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d={bookIcon} /></svg>
              {d.nav.module}
            </a>
          </li>
        </ul>
      </details>

      <a
        href={learnHref}
        aria-current={page === 'learn' ? 'page' : undefined}
        class:list={[
          'ml-1 hidden items-center gap-1.5 rounded-full border px-3.5 py-[7px] text-sm font-medium whitespace-nowrap md:inline-flex',
          page === 'learn' ? 'border-ink bg-ink text-paper' : 'border-line hover:border-ink',
        ]}
      >
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d={bookIcon} /></svg>
        {d.nav.module}
      </a>

      <a
        href={appUrl(lang)}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 inline-flex items-center gap-1.5 rounded-full bg-sun px-3.5 py-2 text-sm font-semibold whitespace-nowrap text-[#0b1020] hover:brightness-95"
      >
        <span class="hidden sm:inline">{d.nav.launch}</span><span class="sm:hidden">App</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch (e) {}
  });
  // Close open menus when clicking outside or after choosing a link.
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.lang-menu[open], details.mobile-menu[open]').forEach((el) => {
      const target = e.target as Node;
      if (!el.contains(target) || (target as HTMLElement).closest?.('a')) el.removeAttribute('open');
    });
  });
</script>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
