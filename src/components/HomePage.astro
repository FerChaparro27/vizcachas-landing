---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t, appUrl, localePath, scenarios, REPO_URL, type Locale } from '../i18n';
import skyPole from '../assets/shots/app-sky-pole.png';
import details from '../assets/shots/app-details.png';
import map from '../assets/shots/app-map.png';
import mobile from '../assets/shots/app-mobile.png';
import farSide from '../assets/shots/app-far-side.png';
import compare from '../assets/shots/app-compare2.png';
import learnShot from '../assets/shots/learn-module.png';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);

import fSky from '../assets/features/sky.png';
import fPosition from '../assets/features/position.png';
import fTimeline from '../assets/features/timeline-countdown.png';
import fCompare from '../assets/features/compare.png';
import fMap from '../assets/features/map.png';
import PhoneFrame from './PhoneFrame.astro';
import PolarMapPin from './PolarMapPin.astro';
import FeatureVideo from './FeatureVideo.astro';
import im2Horizon from '../data/im2-horizon.json';

const team = ['Mateo Cerri', 'Fernando Chaparro', 'Facundo Grassino', 'Esteban Porporato', 'Francisco Romero', 'Tomas Vainstub'];
// One crop per feature, in the same order as solution.features.
const featureShots = [fSky, fPosition, fTimeline, fCompare, fMap, mobile];
// Recorded loops (public/videos) for features 01–04; sizes match the recorded crops.
const featureVideos = [
  { name: 'sky', w: 780, h: 448 },
  { name: 'position', w: 700, h: 375 },
  { name: 'timeline', w: 700, h: 180 },
  { name: 'compare', w: 700, h: 500 },
];

// "How it works" diagram: file labels and IM-2's real horizon profile (360 azimuths, LOLA 30 m DEM).
const pipelineFiles = ['horizons · Sun @ IM-2', 'horizon.json', 'ephemeris.json', 'app'];
const elev: number[] = im2Horizon.elevation_deg;
const EL_MIN = -2, EL_MAX = 5;
const yOf = (el: number) => (100 - ((el - EL_MIN) / (EL_MAX - EL_MIN)) * 90).toFixed(2);
const horizonZeroY = yOf(0);
const horizonLine = 'M' + elev.map((el, az) => `${az},${yOf(el)}`).join(' L');
const horizonArea = `${horizonLine} L359,100 L0,100 Z`;

// Teaser figure panels (a)–(d), Nerfies-style.
const panels = [
  { img: skyPole, label: 'a', cls: 'md:col-span-2 aspect-[16/10]' },
  { img: details, label: 'b', cls: 'aspect-[16/10]' },
  { img: map, label: 'c', cls: 'aspect-[16/10]' },
];

// Audience cards: image + deep link.
const audience = [
  { img: compare, pos: 'object-left-top', href: appUrl(lang, scenarios.compare), ext: true },
  { img: learnShot, pos: 'object-left-top', href: localePath(lang, 'learn'), ext: false },
  { img: farSide, pos: 'object-center', href: appUrl(lang, scenarios.farSide), ext: true },
];

// Showcase carousel slides: screenshot + scenario link.
const slides = [
  { img: skyPole, href: appUrl(lang, scenarios.southPole) },
  { img: farSide, href: appUrl(lang, scenarios.farSide) },
  { img: compare, href: appUrl(lang, scenarios.compare) },
  { img: details, href: appUrl(lang, scenarios.southPole) },
  { img: map, href: appUrl(lang, scenarios.southPole) },
];

const hardIcons = [
  'M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16',
  'M3 5h18v14H3zM3 10h18M3 15h18M9 5v14M15 5v14',
  'M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v16M15 6v16',
];

const bibtex = `@software{vizcachas2026navigator,
  title  = {Lunar Landing Site Navigator},
  author = {Cerri, Mateo and Chaparro, Fernando and Grassino, Facundo and
            Porporato, Esteban and Romero, Francisco and Vainstub, Tomas},
  year   = {2026},
  url    = {https://vizcachasfueradeorbita.vercel.app/},
  note   = {Open-source educational tool}
}`;
---

<Base lang={lang} title={d.meta.title} description={d.meta.description}>
  <!-- HERO: centered title, the question, and the three main links -->
  <section class="px-4 pt-20 pb-14 text-center sm:px-6 md:pt-28">
    <h1 class="mx-auto max-w-4xl font-serif text-[2.6rem] leading-[1.04] font-semibold tracking-tight text-balance sm:text-6xl md:text-7xl">
      {d.hero.title}
    </h1>
    <p class="mx-auto mt-6 max-w-2xl font-serif text-xl leading-snug text-balance italic sm:text-2xl">“{d.hero.question}”</p>
    <p class="mx-auto mt-5 max-w-xl leading-relaxed text-balance text-muted">{d.hero.tagline}</p>
    <ul class="mt-9 flex flex-wrap justify-center gap-2.5 text-sm font-medium">
      <li>
        <a href={appUrl(lang)} class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-paper hover:opacity-90">
          {d.hero.ctaApp} <span aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a href={REPO_URL} class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2.5 hover:border-ink">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2z"/></svg>
          {d.hero.ctaCode}
        </a>
      </li>
    </ul>
  </section>

  <!-- TEASER BAND: the tool itself on a dark stage (OpenSpace), labeled panels (Nerfies) -->
  <section class="band">
    <div class="mx-auto max-w-6xl px-4 pt-10 pb-12 sm:px-6">
      <figure>
        <div class="grid gap-3 md:grid-cols-2">
          {
            panels.map((p, i) => (
              <div class:list={['relative overflow-hidden rounded-xl ring-1 ring-white/10', p.cls]}>
                <Image
                  src={p.img}
                  alt={d.teaser.panels[i]}
                  widths={i === 0 ? [720, 1080, 1440] : [480, 720]}
                  sizes={i === 0 ? '(min-width: 768px) 700px, 100vw' : '(min-width: 768px) 300px, 100vw'}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="h-full w-full object-cover object-left-top"
                />
                <span class="absolute bottom-2 left-2 rounded-full bg-black/70 px-2.5 py-1 font-mono text-[0.7rem] text-white backdrop-blur">
                  ({p.label}) {d.teaser.panels[i]}
                </span>
              </div>
            ))
          }
        </div>
        <figcaption class="mx-auto mt-5 max-w-3xl text-center text-sm leading-relaxed text-[#a9b3c9]">{d.teaser.caption}</figcaption>
      </figure>

      <!-- Number above label; flex-col-reverse + justify-end keeps every number on the same top line. -->
      <dl class="mt-12 grid grid-cols-2 gap-y-8 border-t border-white/10 pt-8 md:grid-cols-4">
        {
          d.hero.stats.map((s, i) => (
            <div class:list={['flex flex-col-reverse justify-end border-white/10 px-5', i % 2 === 1 && 'border-l', i > 0 && 'md:border-l']}>
              <dt class="mt-2 text-sm leading-snug text-[#a9b3c9]">{s.label}</dt>
              <dd class="font-mono text-4xl leading-none text-[#eef1f7]">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- AUDIENCE: Shadowmap "solutions" / OpenSpace "every venue" -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="mt-3 text-center font-serif text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{d.audience.title}</h2>
    <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
      {
        d.audience.items.map((a, i) => (
          <a href={audience[i].href} class="group flex flex-col">
            <div class="aspect-[16/10] overflow-hidden rounded-xl bg-[#0b1020] ring-1 ring-line">
              <Image src={audience[i].img} alt="" width={720} class:list={['h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]', audience[i].pos]} />
            </div>
            <div class="flex flex-1 flex-col pt-5">
              <h3 class="font-serif text-2xl font-semibold group-hover:underline group-hover:decoration-line group-hover:underline-offset-4">{a.title}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-muted">{a.body}</p>
              <span class="mt-4 text-sm font-semibold">
                {a.cta} <span aria-hidden="true" class="inline-block transition group-hover:translate-x-0.5">{audience[i].ext ? '↗' : '→'}</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- PROBLEM -->
  <section id="problem" class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="mt-3 max-w-3xl font-serif text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{d.problem.title}</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">{d.problem.intro}</p>
      <!-- Row 1: the three conditions at the pole. Open columns, each led by a small line illustration. -->
      <div class="mt-14 grid md:grid-cols-3 md:divide-x md:divide-line">
        {
          d.problem.points.map((p, i) => (
            <article class:list={['border-t border-line py-8 md:border-t-0 md:py-0', i === 0 ? 'md:pr-8' : i === 1 ? 'md:px-8' : 'md:pl-8']}>
              <svg viewBox="0 0 160 80" class="h-20 w-auto" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
                {i === 0 && (
                  <g>
                    <path d="M4 64 H64 Q84 64 96 40 Q104 28 114 40 Q124 54 156 56" stroke="var(--ink-muted)" stroke-width="1.5" />
                    <path d="M6 58 Q60 50 110 52 T156 52" stroke="var(--sun-ink)" stroke-width="1.5" stroke-dasharray="3 4" />
                    <circle cx="118" cy="50" r="8" fill="var(--sun)" opacity="0.35" />
                    <circle cx="58" cy="54" r="7" fill="var(--sun)" />
                  </g>
                )}
                {i === 1 && (
                  <g>
                    <path d="M4 64 H156" stroke="var(--ink-muted)" stroke-width="1.5" />
                    <path d="M20 64 l7 -11 l7 11" stroke="var(--ink)" stroke-width="1.5" />
                    <circle cx="118" cy="48" r="10" fill="var(--earth)" />
                    <path d="M27 52 L108 47" stroke="var(--earth-ink)" stroke-width="1.5" stroke-dasharray="3 4" />
                  </g>
                )}
                {i === 2 && (
                  <g>
                    {[0, 1, 2, 3, 4, 5, 6].map((k) => (
                      <rect x={4 + k * 21} y="14" width="16" height="16" rx="3" fill="var(--sun)" />
                    ))}
                    {[0, 1, 2, 3, 4, 5, 6].map((k) => (
                      <rect x={4 + k * 21} y="50" width="16" height="16" rx="3" stroke="var(--ink-muted)" stroke-width="1.3" />
                    ))}
                    <path d="M80 34 v10 m-4 -4 l4 4 l4 -4" stroke="var(--ink-muted)" stroke-width="1.5" />
                  </g>
                )}
              </svg>
              <h3 class="mt-5 font-serif text-xl font-semibold">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{p.body}</p>
            </article>
          ))
        }
      </div>

      <!-- Row 2: why it is hard today. Same column pattern as row 1, with icons. -->
      <h3 class="mt-24 font-serif text-2xl font-semibold sm:text-3xl">{d.problem.hardTitle}</h3>
      <p class="mt-3 max-w-3xl leading-relaxed text-muted">{d.problem.hardIntro}</p>
      <div class="mt-10 grid md:grid-cols-3 md:divide-x md:divide-line">
        {
          d.problem.hard.map((h, i) => (
            <article class:list={['border-t border-line py-8 md:border-t-0 md:py-0', i === 0 ? 'md:pr-8' : i === 1 ? 'md:px-8' : 'md:pl-8']}>
              <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" class="text-muted">
                <path d={hardIcons[i]} />
              </svg>
              <h4 class="mt-5 font-serif text-xl font-semibold">{h.title}</h4>
              <p class="mt-2 leading-relaxed text-muted">{h.caption}</p>
            </article>
          ))
        }
      </div>

      <p class="mx-auto mt-24 max-w-4xl text-center font-serif text-4xl leading-tight font-semibold tracking-tight text-balance text-earth-ink sm:text-5xl">
        {d.problem.conclusion}
      </p>
    </div>
  </section>

  <!-- SHOWCASE CAROUSEL: OpenSpace "See what's possible" -->
  <section id="showcase" class="band" aria-roledescription="carousel" aria-label={d.showcase.title}>
    <div class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <h2 class="font-serif text-3xl font-semibold tracking-tight text-[#eef1f7] sm:text-4xl">{d.showcase.title}</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-[#a9b3c9]">{d.showcase.intro}</p>
        </div>
        <div class="flex gap-2">
          <button type="button" id="showcase-toggle" aria-pressed="false" aria-label={d.ui.pause} data-label-pause={d.ui.pause} data-label-play={d.ui.play} class="carousel-btn">
            <svg class="icon-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="2" y="1" width="3.5" height="12" rx="1" fill="currentColor" /><rect x="8.5" y="1" width="3.5" height="12" rx="1" fill="currentColor" /></svg>
            <svg class="icon-play hidden" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5z" fill="currentColor" /></svg>
          </button>
          <button type="button" data-carousel="-1" aria-label={d.showcase.prev} class="carousel-btn">←</button>
          <button type="button" data-carousel="1" aria-label={d.showcase.next} class="carousel-btn">→</button>
        </div>
      </div>
    </div>
    <!-- Slides are rendered twice; the second copy is decorative and makes the continuous loop seamless. -->
    <ul
      id="showcase-track"
      class="mt-10 flex gap-5 overflow-x-auto pb-20 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      style="padding-inline: max(1rem, calc((100vw - 72rem) / 2 + 1.5rem));"
    >
      {
        [0, 1].flatMap((copy) => d.showcase.slides.map((s, i) => (
          <li
            class="w-[86%] shrink-0 sm:w-[540px]"
            data-copy={copy}
            aria-hidden={copy === 1 ? 'true' : undefined}
            aria-roledescription={copy === 0 ? 'slide' : undefined}
            aria-label={copy === 0 ? `${i + 1} / ${slides.length}` : undefined}
          >
            <a href={slides[i].href} tabindex={copy === 1 ? -1 : undefined} class="group block overflow-hidden rounded-2xl bg-[#121a2e] ring-1 ring-white/10 hover:ring-white/30">
              <div class="relative aspect-[16/10] overflow-hidden">
                <Image src={slides[i].img} alt="" widths={[540, 1080]} sizes="540px" class="h-full w-full object-cover object-left-top transition duration-500 group-hover:scale-[1.02]" />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent p-5 pt-16">
                  <p class="font-mono text-[0.7rem] tracking-[0.14em] text-[#ffc54d] uppercase">{s.eyebrow}</p>
                  <h3 class="mt-1 text-lg font-semibold text-white">{s.title}</h3>
                </div>
              </div>
              <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                <p class="min-w-0 text-sm leading-relaxed text-[#a9b3c9]">{s.body}</p>
                <span class="shrink-0 text-sm font-semibold whitespace-nowrap text-[#eef1f7]">{d.showcase.open} ↗</span>
              </div>
            </a>
          </li>
        )))
      }
    </ul>
  </section>

  <!-- SOLUTION: how it works -->
  <section id="solution" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="mt-4 max-w-4xl font-serif text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-6xl">
      {d.solution.titleLead}<span class="text-earth-ink">{d.solution.titleEmphasis}</span>
    </h2>

    <!-- Features: alternating rows, text on one side and a crop of that feature on the other. -->
    <h3 class="mt-20 font-serif text-2xl font-semibold sm:text-3xl">{d.solution.featuresTitle}</h3>
    <div class="mt-4">
      {
        d.solution.features.map((f, i) => (
          <div class="grid items-center gap-8 border-t border-line py-12 md:grid-cols-2 md:gap-16">
            <div class:list={['min-w-0', i % 2 === 1 && 'md:order-2']}>
              <p class="font-mono text-sm text-muted">{String(i + 1).padStart(2, '0')}</p>
              <h4 class="mt-2 font-serif text-2xl font-semibold">{f.title}</h4>
              <p class="mt-3 max-w-md text-lg leading-relaxed text-muted">{f.body}</p>
            </div>
            <div class:list={['flex min-w-0', i % 2 === 1 ? 'md:order-1 md:justify-start' : 'md:justify-end']}>
              <!-- Same stage for every visual (one proportion), with a pause/play control. -->
              <div class="feature-stage relative flex aspect-[5/4] w-full max-w-[520px] items-center justify-center overflow-hidden rounded-xl bg-[#0b0d12] p-5 shadow-2xl shadow-black/25 ring-1 ring-black/10">
                {i === 5 ? (
                  <PhoneFrame src={featureShots[i]} alt={f.title} video="mobile" width="33%" />
                ) : i === 4 ? (
                  <PolarMapPin alt={f.title} class="aspect-square !h-full !w-auto !bg-transparent !p-0 !shadow-none !outline-none" />
                ) : (
                  <FeatureVideo
                    name={featureVideos[i].name}
                    label={f.title}
                    width={featureVideos[i].w}
                    height={featureVideos[i].h}
                    class="max-h-full w-full rounded-md object-contain"
                  />
                )}
                <button type="button" class="motion-toggle" aria-pressed="false" aria-label={d.ui.pause} data-label-pause={d.ui.pause} data-label-play={d.ui.play}>
                  <svg class="icon-pause" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><rect x="2" y="1" width="3.5" height="12" rx="1" fill="currentColor" /><rect x="8.5" y="1" width="3.5" height="12" rx="1" fill="currentColor" /></svg>
                  <svg class="icon-play hidden" width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5z" fill="currentColor" /></svg>
                </button>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 rounded-xl bg-ink p-6 text-paper sm:flex-row sm:items-center sm:p-8">
      <p class="font-serif text-xl">{d.solution.learnTeaser}</p>
      <a href={localePath(lang, 'learn')} class="shrink-0 rounded-full bg-sun px-5 py-2.5 font-semibold text-[#0b1020] hover:brightness-95">{d.solution.learnCta} →</a>
    </div>
  </section>

  <!-- TEAM -->
  <section id="team" class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="mt-3 flex items-center gap-4">
        <img src="/assets/logo-vizcachas.svg" alt="" width="64" height="64" class="h-16 w-16 rounded-full border border-line bg-white p-1 dark:invert" />
        <h2 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">{d.team.title}</h2>
      </div>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">{d.team.intro}</p>
      <ul class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 sm:gap-x-12">
        {
          team.map((name) => (
            <li class="border-t border-line py-5 font-serif text-2xl">{name}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FINAL CTA: OpenSpace "Start exploring" -->
  <section class="px-4 sm:px-6">
    <div class="band relative mx-auto max-w-4xl overflow-hidden rounded-3xl px-6 py-14 text-center ring-1 ring-white/10">
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-48 w-[80%] rounded-[50%] bg-[#6cb2ff]/20 blur-3xl"></div>
      <h2 class="relative font-serif text-3xl font-semibold text-[#eef1f7] sm:text-4xl">{d.cta.title}</h2>
      <p class="relative mt-3 text-[#a9b3c9]">{d.cta.body}</p>
      <div class="relative mt-8 flex flex-wrap justify-center gap-3 text-sm font-semibold">
        <a href={appUrl(lang)} class="rounded-full bg-sun px-5 py-2.5 text-[#0b1020] hover:brightness-95">{d.cta.app} →</a>
        <a href={REPO_URL} class="rounded-full border border-white/25 px-5 py-2.5 text-[#eef1f7] hover:border-white/60">{d.cta.repo}</a>
        <a href={localePath(lang, 'learn')} class="rounded-full border border-white/25 px-5 py-2.5 text-[#eef1f7] hover:border-white/60">{d.cta.learn}</a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: technical detail, placed near the reference material. -->
  <section id="how" class="mx-auto mt-28 max-w-6xl px-4 sm:px-6">
    <!-- Pipeline: data-flow diagram. Each stage shows the real thing it produces (IM-2 data from the app repo). -->
    <h2 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">{d.solution.pipelineTitle}</h2>
    <ol class="mt-8 grid gap-12 md:grid-cols-4 md:gap-10">
      {
        d.solution.pipeline.map((s, i) => (
          <li class="relative min-w-0">
            <div class="overflow-hidden rounded-xl bg-[#0b0d12] ring-1 ring-black/10 shadow-xl shadow-black/15">
              <div class="flex items-center gap-1.5 border-b border-white/10 px-3 py-2">
                <span class:list={['h-2 w-2 rounded-full', i < 2 ? 'bg-[#6cb2ff]' : i === 2 ? 'bg-[#ffc54d]' : 'bg-[#eef1f7]']}></span>
                <span class="truncate font-mono text-[0.68rem] text-[#a9b3c9]">{pipelineFiles[i]}</span>
              </div>
              <div class="h-36 overflow-hidden">
                {i === 0 && (
                  <pre class="h-full p-3 font-mono text-[0.66rem] leading-relaxed text-[#eef1f7]"><span class="text-[#a9b3c9]">Date (UT)          Azi°    Elev°</span>
2026-Nov-20 12:00  18.442  6.487
2026-Nov-20 13:00  17.933  6.501
2026-Nov-20 14:00  17.424  6.515
2026-Nov-20 15:00  16.915  6.528
<span class="text-[#a9b3c9]">…</span></pre>
                )}
                {i === 1 && (
                  <svg viewBox="0 0 360 120" preserveAspectRatio="none" class="h-full w-full" role="img" aria-label="IM-2 horizon profile, 360 azimuths">
                    <line x1="0" y1={horizonZeroY} x2="360" y2={horizonZeroY} stroke="#2c3758" stroke-dasharray="3 3" />
                    <path d={horizonArea} fill="#6cb2ff" fill-opacity="0.18" />
                    <path d={horizonLine} fill="none" stroke="#6cb2ff" stroke-width="1.6" vector-effect="non-scaling-stroke" />
                    {['N', 'E', 'S', 'W'].map((c, k) => (
                      <text x={k * 90 + 4} y="114" fill="#a9b3c9" font-size="10" font-family="var(--font-mono)">{c}</text>
                    ))}
                  </svg>
                )}
                {i === 2 && (
                  <pre class="h-full p-3 font-mono text-[0.68rem] leading-relaxed text-[#eef1f7]">{'{'} <span class="text-[#6cb2ff]">"site_id"</span>: "intuitive-machines-2",
  <span class="text-[#6cb2ff]">"time"</span>: {'{'} "step_s": 3600,
            "count": 10224 {'}'},
  <span class="text-[#ffc54d]">"sun"</span>: {'{'} "azimuth_deg":
    [255.862, 255.358, …] {'}'} {'}'}</pre>
                )}
                {i === 3 && (
                  <Image src={fSky} alt="" widths={[300, 600]} sizes="300px" class="h-full w-full object-cover object-[50%_70%]" />
                )}
              </div>
            </div>
            {i < 3 && (
              <span aria-hidden="true" class="absolute left-1/2 -bottom-9 -translate-x-1/2 text-xl text-muted md:top-[4.2rem] md:-right-8 md:bottom-auto md:left-auto md:translate-x-0">
                <span class="md:hidden">↓</span><span class="hidden md:inline">→</span>
              </span>
            )}
            <p class="mt-4 font-mono text-[0.7rem] tracking-wider text-muted uppercase">{s.tag}</p>
            <p class="mt-1 font-semibold">{s.title}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 max-w-4xl text-sm text-muted">{d.solution.pipelineNote}</p>

    <!-- Validation: a statement, not a card. -->
    <div class="mt-20 grid gap-6 border-y border-line py-12 md:grid-cols-[auto_1fr] md:gap-10">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ok/15 text-2xl text-ok" aria-hidden="true">✓</span>
      <div>
        <h3 class="font-serif text-2xl font-semibold">{d.solution.validationTitle}</h3>
        <p class="mt-3 max-w-3xl font-serif text-xl leading-relaxed text-muted">{d.solution.validationBody}</p>
      </div>
    </div>
  </section>

  <!-- DATA, CREDITS AND CITATION: reference material, collapsed. The independence notice stays visible. -->
  <section id="data" class="mx-auto mt-24 max-w-4xl px-4 sm:px-6">
    <h2 class="font-serif text-2xl font-semibold">{d.data.sectionTitle}</h2>
    <p id="independence" class="mt-3 text-sm leading-relaxed text-muted">
      <strong class="font-semibold text-ink">{d.data.disclaimerTitle}.</strong> {d.data.disclaimer}
    </p>

    <div class="mt-6 border-b border-line">
      <details id="data-sources" class="ref-group">
        <summary>{d.data.groups[0]}</summary>
        <table class="mb-6 w-full text-left text-sm">
          <tbody>
            {
              d.data.sources.map((s) => (
                <tr class="border-t border-line">
                  <th scope="row" class="py-3 pr-4 align-top font-medium">
                    <a href={s.url} class="underline decoration-line underline-offset-4 hover:decoration-ink">{s.name}</a>
                    <span class="mt-0.5 block font-mono text-xs font-normal text-muted">{s.org}</span>
                  </th>
                  <td class="py-3 align-top text-muted">{s.use}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </details>

      <details id="data-software" class="ref-group">
        <summary>{d.data.groups[1]}</summary>
        <div class="mb-6 grid gap-6 text-sm md:grid-cols-3">
          <div><h3 class="font-semibold">{d.data.softwareTitle}</h3><p class="mt-1.5 leading-relaxed text-muted">{d.data.software}</p></div>
          <div><h3 class="font-semibold">{d.data.aiTitle}</h3><p class="mt-1.5 leading-relaxed text-muted">{d.data.ai}</p></div>
          <div><h3 class="font-semibold">{d.data.licenseTitle}</h3><p class="mt-1.5 leading-relaxed text-muted">{d.data.license}</p></div>
        </div>
      </details>

      <details id="data-cite" class="ref-group">
        <summary>{d.data.groups[2]}</summary>
        <div class="mb-6">
          <p class="text-sm leading-relaxed text-muted">{d.cite.intro}</p>
          {
            [
              { label: d.cite.toolLabel, text: bibtex, id: 'cite-tool' },
              { label: d.cite.dataLabel, text: d.cite.dataCitation, id: 'cite-data' },
            ].map((c) => (
              <div class="mt-5">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-sm font-semibold">{c.label}</h3>
                  <button type="button" class="copy-btn rounded-full border border-line px-3 py-1 text-xs hover:border-ink" data-copy={c.id} data-copied={d.cite.copied}>
                    {d.cite.copy}
                  </button>
                </div>
                <pre id={c.id} class="mt-2 overflow-x-auto rounded-lg bg-surface-2 p-4 font-mono text-xs leading-relaxed whitespace-pre-wrap">{c.text}</pre>
              </div>
            ))
          }
        </div>
      </details>
    </div>
  </section>
</Base>

<style>
  .ref-group { border-top: 1px solid var(--line); }
  .ref-group > summary {
    display: flex; align-items: center; justify-content: space-between;
    cursor: pointer; list-style: none; padding: 1rem 0; font-weight: 600;
  }
  .ref-group > summary::-webkit-details-marker { display: none; }
  .ref-group > summary::after {
    content: '+'; font-family: var(--font-mono); font-weight: 400; color: var(--ink-muted);
  }
  .ref-group[open] > summary::after { content: '−'; }
</style>

<script>
  // Showcase carousel: slow continuous scroll in a seamless loop.
  // Pauses on hover, focus or touch, when off screen or in a hidden tab; disabled for reduced motion.
  const SPEED_PX_S = 30;
  const RESUME_AFTER_MS = 3000;
  const track = document.getElementById('showcase-track');
  if (track) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Width of one full copy of the slides = offset of the first card of the second copy.
    const loopWidth = () => {
      const first = track.querySelector<HTMLElement>('li[data-copy="0"]');
      const second = track.querySelector<HTMLElement>('li[data-copy="1"]');
      return first && second ? second.offsetLeft - first.offsetLeft : 0;
    };
    let hovering = false;
    let visible = true;
    let pausedUntil = 0;
    let userPaused = reduced; // pause button state; starts paused for reduced motion
    let last = 0;
    let pos = track.scrollLeft;
    const hold = (ms = RESUME_AFTER_MS) => (pausedUntil = performance.now() + ms);

    // Pause / play button (visible control for the moving carousel).
    const toggle = document.getElementById('showcase-toggle');
    const syncToggle = () => {
      if (!toggle) return;
      toggle.setAttribute('aria-pressed', String(userPaused));
      toggle.setAttribute('aria-label', userPaused ? toggle.dataset.labelPlay ?? '' : toggle.dataset.labelPause ?? '');
      toggle.querySelector('.icon-pause')?.classList.toggle('hidden', userPaused);
      toggle.querySelector('.icon-play')?.classList.toggle('hidden', !userPaused);
    };
    toggle?.addEventListener('click', () => {
      userPaused = !userPaused;
      syncToggle();
    });
    syncToggle();

    const step = (now: number) => {
      const dt = last ? Math.min(now - last, 100) : 0;
      last = now;
      const running = !userPaused && visible && !hovering && !document.hidden && now > pausedUntil;
      if (running) {
        const w = loopWidth();
        pos += (SPEED_PX_S * dt) / 1000;
        if (w > 0 && pos >= w) pos -= w;
        track.scrollLeft = pos;
      } else {
        pos = track.scrollLeft; // keep in sync with manual scrolling
      }
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);

    track.addEventListener('mouseenter', () => (hovering = true));
    track.addEventListener('mouseleave', () => (hovering = false));
    track.addEventListener('focusin', () => (hovering = true));
    track.addEventListener('focusout', () => (hovering = false));
    track.addEventListener('pointerdown', () => hold());
    track.addEventListener('touchstart', () => hold(), { passive: true });
    track.addEventListener('wheel', () => hold(), { passive: true });
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(track);

    // Arrows: move one card and pause briefly.
    document.querySelectorAll<HTMLButtonElement>('[data-carousel]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = track.querySelector('li');
        if (!card) return;
        hold();
        let target = track.scrollLeft + Number(btn.dataset.carousel) * (card.clientWidth + 20);
        const w = loopWidth();
        if (w > 0 && target < 0) target += w;
        if (w > 0 && target >= w) target -= w;
        track.scrollTo({ left: target, behavior: reduced ? 'auto' : 'smooth' });
      });
    });
  }
  // Open the matching collapsed block when the URL points to it (e.g. #data-cite from the footer).
  const openFromHash = () => {
    const el = location.hash ? document.getElementById(location.hash.slice(1)) : null;
    if (el instanceof HTMLDetailsElement) {
      el.open = true;
      el.scrollIntoView({ block: 'start' });
    }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  // Pause/play control on each feature visual (videos and the polar-map pin).
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLButtonElement>('.motion-toggle').forEach((btn) => {
    const stage = btn.closest('.feature-stage');
    const video = stage?.querySelector<HTMLVideoElement>('video');
    const pin = stage?.querySelector<HTMLElement>('.polar-pin');
    let paused = reducedMotion;
    const sync = () => {
      btn.setAttribute('aria-pressed', String(paused));
      btn.setAttribute('aria-label', paused ? btn.dataset.labelPlay ?? '' : btn.dataset.labelPause ?? '');
      btn.querySelector('.icon-pause')?.classList.toggle('hidden', paused);
      btn.querySelector('.icon-play')?.classList.toggle('hidden', !paused);
    };
    btn.addEventListener('click', () => {
      paused = !paused;
      if (video) {
        video.dataset.paused = paused ? '1' : '0';
        if (paused) video.pause();
        else { video.preload = 'auto'; video.play().catch(() => {}); }
      }
      pin?.dispatchEvent(new CustomEvent('motion-toggle', { detail: { paused } }));
      sync();
    });
    sync();
  });

  // Copy buttons for the citation blocks.
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const pre = document.getElementById(btn.dataset.copy ?? '');
      if (!pre) return;
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        btn.textContent = btn.dataset.copied ?? 'OK';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
      setTimeout(() => (btn.textContent = original), 1600);
    });
  });
</script>
