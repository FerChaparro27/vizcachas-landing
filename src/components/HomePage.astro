---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t, appUrl, localePath, scenarios, REPO_URL, type Locale } from '../i18n';
import skyPole from '../assets/shots/app-sky-pole.png';
import details from '../assets/shots/app-details.png';
import map from '../assets/shots/app-map.png';
import mobile from '../assets/shots/app-mobile.png';
import farSide from '../assets/shots/app-far-side.png';
import compare from '../assets/shots/app-compare2.png';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);

import fSky from '../assets/features/sky.png';
import fPosition from '../assets/features/position.png';
import fTimeline from '../assets/features/timeline-countdown.png';
import fCompare from '../assets/features/compare.png';
import fMap from '../assets/features/map.png';

const team = ['Mateo Cerri', 'Fernando Chaparro', 'Facundo Grassino', 'Estepan Porporato', 'Francisco Romero', 'Tomas Vainstub'];
// One crop per feature, in the same order as solution.features.
const featureShots = [fSky, fPosition, fTimeline, fCompare, fMap, mobile];

// Teaser figure panels (a)–(d), Nerfies-style.
const panels = [
  { img: skyPole, label: 'a', cls: 'md:col-span-2 aspect-[16/10]' },
  { img: details, label: 'b', cls: 'aspect-[16/10]' },
  { img: map, label: 'c', cls: 'aspect-[16/10]' },
];

// Audience cards: image + deep link.
const audience = [
  { img: compare, pos: 'object-left-top', href: appUrl(lang, scenarios.compare), ext: true },
  { img: null, pos: '', href: localePath(lang, 'learn'), ext: false },
  { img: farSide, pos: 'object-center', href: appUrl(lang, scenarios.farSide), ext: true },
];

// Showcase carousel slides: screenshot + scenario link.
const slides = [
  { img: skyPole, href: appUrl(lang, scenarios.southPole) },
  { img: farSide, href: appUrl(lang, scenarios.farSide) },
  { img: compare, href: appUrl(lang, scenarios.compare) },
  { img: details, href: appUrl(lang, scenarios.southPole) },
  { img: map, href: appUrl(lang, scenarios.southPole) },
];

const hardIcons = [
  'M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16',
  'M3 5h18v14H3zM3 10h18M3 15h18M9 5v14M15 5v14',
  'M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v16M15 6v16',
];

const bibtex = `@software{vizcachas2026navigator,
  title  = {Lunar Landing Site Navigator},
  author = {Cerri, Mateo and Chaparro, Fernando and Grassino, Facundo and
            Porporato, Estepan and Romero, Francisco and Vainstub, Tomas},
  year   = {2026},
  url    = {https://vizcachasfueradeorbita.vercel.app/},
  note   = {Open-source educational tool}
}`;
---

<Base lang={lang} title={d.meta.title} description={d.meta.description}>
  <!-- HERO: centered, Nerfies-style (title, authors, link buttons) with Shadowmap-like pill CTAs -->
  <section class="px-4 pt-16 pb-12 text-center sm:px-6 md:pt-24">
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted">
      <span class="h-1.5 w-1.5 rounded-full bg-sun"></span>{d.hero.badge}
    </p>
    <h1 class="mx-auto mt-6 max-w-4xl font-serif text-[2.6rem] leading-[1.04] font-semibold tracking-tight text-balance sm:text-6xl md:text-7xl">
      {d.hero.title}
    </h1>
    <p class="mx-auto mt-6 max-w-2xl font-serif text-xl leading-snug text-balance italic sm:text-2xl">“{d.hero.question}”</p>
    <p class="mx-auto mt-6 max-w-2xl text-sm leading-relaxed text-muted">
      {team.map((n, i) => <><span class="whitespace-nowrap text-ink">{n}</span>{i < team.length - 1 && <span aria-hidden="true"> · </span>}</>)}
      <br /><span class="font-mono text-xs tracking-wide">Vizcachas fuera de órbita</span>
    </p>
    <ul class="mt-8 flex flex-wrap justify-center gap-2.5 text-sm font-medium">
      <li>
        <a href={appUrl(lang)} class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-paper hover:opacity-90">
          {d.hero.ctaApp} <span aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a href={REPO_URL} class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2.5 hover:border-ink">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2z"/></svg>
          {d.hero.ctaCode}
        </a>
      </li>
      <li>
        <a href={localePath(lang, 'learn')} class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2.5 hover:border-ink">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6l9-3 9 3-9 3-9-3zM7 8v5c0 1.7 2.2 3 5 3s5-1.3 5-3V8M21 6v6"/></svg>
          {d.hero.ctaLearn}
        </a>
      </li>
      <li>
        <a href="#cite" class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2.5 hover:border-ink">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 7h4v4H8c0 2 1 3 3 3M14 7h4v4h-3c0 2 1 3 3 3"/></svg>
          {d.hero.ctaCite}
        </a>
      </li>
    </ul>
  </section>

  <!-- TEASER BAND: the tool itself on a dark stage (OpenSpace), labeled panels (Nerfies) -->
  <section class="band">
    <div class="mx-auto max-w-6xl px-4 pt-10 pb-12 sm:px-6">
      <figure>
        <div class="grid gap-3 md:grid-cols-[1fr_1fr_0.62fr]">
          {
            panels.map((p, i) => (
              <div class:list={['relative overflow-hidden rounded-xl ring-1 ring-white/10', p.cls]}>
                <Image
                  src={p.img}
                  alt={d.teaser.panels[i]}
                  widths={i === 0 ? [720, 1080, 1440] : [480, 720]}
                  sizes={i === 0 ? '(min-width: 768px) 700px, 100vw' : '(min-width: 768px) 300px, 100vw'}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="h-full w-full object-cover object-left-top"
                />
                <span class="absolute bottom-2 left-2 rounded-full bg-black/70 px-2.5 py-1 font-mono text-[0.7rem] text-white backdrop-blur">
                  ({p.label}) {d.teaser.panels[i]}
                </span>
              </div>
            ))
          }
          <div class="relative hidden overflow-hidden rounded-xl ring-1 ring-white/10 md:col-start-3 md:row-span-2 md:row-start-1 md:block">
            <Image src={mobile} alt={d.teaser.panels[3]} widths={[240, 480]} sizes="240px" class="h-full w-full object-cover object-top" />
            <span class="absolute bottom-2 left-2 rounded-full bg-black/70 px-2.5 py-1 font-mono text-[0.7rem] text-white">(d) {d.teaser.panels[3]}</span>
          </div>
        </div>
        <figcaption class="mx-auto mt-5 max-w-3xl text-center text-sm leading-relaxed text-[#a9b3c9]">{d.teaser.caption}</figcaption>
      </figure>

      <dl class="mt-10 grid grid-cols-2 gap-y-6 border-t border-white/10 pt-8 md:grid-cols-4">
        {
          d.hero.stats.map((s) => (
            <div class="flex flex-col-reverse px-2 text-center">
              <dt class="mt-1 text-xs leading-snug text-[#a9b3c9]">{s.label}</dt>
              <dd class="font-mono text-3xl text-[#eef1f7]">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- AUDIENCE: Shadowmap "solutions" / OpenSpace "every venue" -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <p class="kicker text-center">{d.audience.kicker}</p>
    <h2 class="mt-3 text-center font-serif text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{d.audience.title}</h2>
    <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
      {
        d.audience.items.map((a, i) => (
          <a href={audience[i].href} class="group flex flex-col">
            <div class="aspect-[16/10] overflow-hidden rounded-xl bg-[#0b1020] ring-1 ring-line">
              {audience[i].img ? (
                <Image src={audience[i].img!} alt="" width={720} class:list={['h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]', audience[i].pos]} />
              ) : (
                <div class="flex h-full items-center justify-center bg-surface-2 p-6">
                  <svg viewBox="0 0 200 110" class="h-full w-auto" aria-hidden="true">
                    <rect x="0" y="80" width="200" height="30" fill="var(--line)" />
                    <line x1="0" y1="80" x2="200" y2="80" stroke="var(--ink-muted)" />
                    <path d="M20 80 Q100 -20 180 80" fill="none" stroke="var(--sun-ink)" stroke-dasharray="4 3" />
                    <circle cx="100" cy="30" r="9" fill="var(--sun)" />
                    <path d="M100 80 L100 30" stroke="var(--ink-muted)" stroke-dasharray="2 3" />
                    <path d="M128 80 A28 28 0 0 0 120 60" fill="none" stroke="var(--earth-ink)" stroke-width="2" />
                    <text x="134" y="70" font-size="10" fill="var(--earth-ink)" font-family="var(--font-mono)">+62°</text>
                  </svg>
                </div>
              )}
            </div>
            <div class="flex flex-1 flex-col pt-5">
              <h3 class="font-serif text-2xl font-semibold group-hover:underline group-hover:decoration-line group-hover:underline-offset-4">{a.title}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-muted">{a.body}</p>
              <span class="mt-4 text-sm font-semibold">
                {a.cta} <span aria-hidden="true" class="inline-block transition group-hover:translate-x-0.5">{audience[i].ext ? '↗' : '→'}</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- PROBLEM -->
  <section id="problem" class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="kicker">{d.problem.kicker}</p>
      <h2 class="mt-3 max-w-3xl font-serif text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{d.problem.title}</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">{d.problem.intro}</p>
      <!-- Three points as open columns led by a real figure (no boxes). -->
      <div class="mt-14 grid md:grid-cols-3 md:divide-x md:divide-line">
        {
          d.problem.points.map((p, i) => (
            <article class:list={['border-t border-line py-8 md:border-t-0 md:py-0', i === 0 ? 'md:pr-8' : i === 1 ? 'md:px-8' : 'md:pl-8']}>
              <p class:list={['font-mono text-4xl tracking-tight lg:text-5xl', i === 1 ? 'text-earth-ink' : 'text-sun-ink']}>{p.figure}</p>
              <h3 class="mt-5 font-serif text-xl font-semibold">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{p.body}</p>
            </article>
          ))
        }
      </div>

      <!-- Why it is hard today: a title column + a ruled list. -->
      <div class="mt-24 grid gap-10 md:grid-cols-[0.8fr_1.2fr]">
        <div>
          <h3 class="font-serif text-2xl font-semibold sm:text-3xl">{d.problem.hardTitle}</h3>
          <p class="mt-3 leading-relaxed text-muted">{d.problem.hardIntro}</p>
        </div>
        <ul>
          {
            d.problem.hard.map((h, i) => (
              <li class="flex gap-5 border-t border-line py-6 last:border-b">
                <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" class="mt-0.5 shrink-0 text-muted">
                  <path d={hardIcons[i]} />
                </svg>
                <div>
                  <h4 class="font-semibold">{h.title}</h4>
                  <p class="mt-1 leading-relaxed text-muted">{h.caption}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="mx-auto mt-20 max-w-3xl text-center font-serif text-2xl leading-snug text-balance sm:text-3xl">{d.problem.conclusion}</p>
    </div>
  </section>

  <!-- SHOWCASE CAROUSEL: OpenSpace "See what's possible" -->
  <section id="showcase" class="band" aria-roledescription="carousel" aria-label={d.showcase.title}>
    <div class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker !text-[#a9b3c9]">{d.showcase.kicker}</p>
          <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-[#eef1f7] sm:text-4xl">{d.showcase.title}</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-[#a9b3c9]">{d.showcase.intro}</p>
        </div>
        <div class="flex gap-2">
          <button type="button" data-carousel="-1" aria-label={d.showcase.prev} class="carousel-btn">←</button>
          <button type="button" data-carousel="1" aria-label={d.showcase.next} class="carousel-btn">→</button>
        </div>
      </div>
    </div>
    <!-- Slides are rendered twice; the second copy is decorative and makes the continuous loop seamless. -->
    <ul
      id="showcase-track"
      class="mt-10 flex gap-5 overflow-x-auto pb-20 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      style="padding-inline: max(1rem, calc((100vw - 72rem) / 2 + 1.5rem));"
    >
      {
        [0, 1].flatMap((copy) => d.showcase.slides.map((s, i) => (
          <li
            class="w-[86%] shrink-0 sm:w-[540px]"
            data-copy={copy}
            aria-hidden={copy === 1 ? 'true' : undefined}
            aria-roledescription={copy === 0 ? 'slide' : undefined}
            aria-label={copy === 0 ? `${i + 1} / ${slides.length}` : undefined}
          >
            <a href={slides[i].href} tabindex={copy === 1 ? -1 : undefined} class="group block overflow-hidden rounded-2xl bg-[#121a2e] ring-1 ring-white/10 hover:ring-white/30">
              <div class="relative aspect-[16/10] overflow-hidden">
                <Image src={slides[i].img} alt="" widths={[540, 1080]} sizes="540px" class="h-full w-full object-cover object-left-top transition duration-500 group-hover:scale-[1.02]" />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent p-5 pt-16">
                  <p class="font-mono text-[0.7rem] tracking-[0.14em] text-[#ffc54d] uppercase">{s.eyebrow}</p>
                  <h3 class="mt-1 text-lg font-semibold text-white">{s.title}</h3>
                </div>
              </div>
              <div class="flex items-start justify-between gap-4 p-5">
                <p class="text-sm leading-relaxed text-[#a9b3c9]">{s.body}</p>
                <span class="shrink-0 text-sm font-semibold whitespace-nowrap text-[#eef1f7]">{d.showcase.open} ↗</span>
              </div>
            </a>
          </li>
        )))
      }
    </ul>
  </section>

  <!-- SOLUTION: how it works -->
  <section id="solution" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <p class="kicker">{d.solution.kicker}</p>
    <h2 class="mt-3 max-w-3xl font-serif text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{d.solution.title}</h2>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">{d.solution.intro}</p>

    <!-- Features: alternating rows, text on one side and a crop of that feature on the other. -->
    <h3 class="mt-20 font-serif text-2xl font-semibold sm:text-3xl">{d.solution.featuresTitle}</h3>
    <div class="mt-4">
      {
        d.solution.features.map((f, i) => (
          <div class="grid items-center gap-8 border-t border-line py-12 md:grid-cols-2 md:gap-16">
            <div class:list={['min-w-0', i % 2 === 1 && 'md:order-2']}>
              <p class="font-mono text-sm text-muted">{String(i + 1).padStart(2, '0')}</p>
              <h4 class="mt-2 font-serif text-2xl font-semibold">{f.title}</h4>
              <p class="mt-3 max-w-md text-lg leading-relaxed text-muted">{f.body}</p>
            </div>
            <div class:list={['flex min-w-0', i % 2 === 1 ? 'md:order-1 md:justify-start' : 'md:justify-end']}>
              <Image
                src={featureShots[i]}
                alt={f.title}
                widths={[360, 720]}
                sizes="(min-width: 768px) 520px, 100vw"
                class:list={[
                  'h-auto rounded-xl bg-[#0b0d12] shadow-2xl shadow-black/25 ring-1 ring-black/10',
                  i === 4 ? 'w-[64%] max-w-[300px]' : i === 5 ? 'w-[48%] max-w-[230px]' : 'w-full max-w-[520px]',
                ]}
              />
            </div>
          </div>
        ))
      }
    </div>

    <!-- Pipeline: a data line with one node per stage (vertical on phones). -->
    <h3 class="mt-16 font-serif text-2xl font-semibold sm:text-3xl">{d.solution.pipelineTitle}</h3>
    <ol class="relative mt-8 grid gap-8 border-l border-line pl-6 md:grid-cols-4 md:gap-8 md:border-l-0 md:pt-9 md:pl-0">
      <span aria-hidden="true" class="absolute top-[7px] right-0 left-0 hidden h-px bg-line md:block"></span>
      {
        d.solution.pipeline.map((s, i) => (
          <li class="relative">
            <span
              aria-hidden="true"
              class:list={[
                'absolute top-1 -left-[31px] h-3.5 w-3.5 rounded-full ring-4 ring-paper md:-top-9 md:left-0',
                i < 2 ? 'bg-earth' : i === 2 ? 'bg-sun' : 'bg-ink',
              ]}
            ></span>
            <span class="font-mono text-[0.7rem] tracking-wider text-muted uppercase">{s.tag}</span>
            <p class="mt-1 font-semibold">{s.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 max-w-4xl text-sm text-muted">{d.solution.pipelineNote}</p>

    <!-- Validation: a statement, not a card. -->
    <div class="mt-20 grid gap-6 border-y border-line py-12 md:grid-cols-[auto_1fr] md:gap-10">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ok/15 text-2xl text-ok" aria-hidden="true">✓</span>
      <div>
        <h3 class="font-serif text-2xl font-semibold">{d.solution.validationTitle}</h3>
        <p class="mt-3 max-w-3xl font-serif text-xl leading-relaxed text-muted">{d.solution.validationBody}</p>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 rounded-xl bg-ink p-6 text-paper sm:flex-row sm:items-center sm:p-8">
      <p class="font-serif text-xl">{d.solution.learnTeaser}</p>
      <a href={localePath(lang, 'learn')} class="shrink-0 rounded-full bg-sun px-5 py-2.5 font-semibold text-[#0b1020] hover:brightness-95">{d.solution.learnCta} →</a>
    </div>
  </section>

  <!-- DATA & CREDITS -->
  <section id="data" class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="kicker">{d.data.kicker}</p>
      <h2 class="mt-3 max-w-3xl font-serif text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{d.data.title}</h2>
      <div class="mt-10 overflow-hidden rounded-2xl border border-line">
        <table class="w-full text-left text-sm">
          <tbody>
            {
              d.data.sources.map((s) => (
                <tr class="border-b border-line last:border-0 even:bg-surface">
                  <th scope="row" class="px-4 py-3 align-top font-medium">
                    <a href={s.url} class="underline decoration-line underline-offset-4 hover:decoration-ink">{s.name}</a>
                    <span class="mt-0.5 block font-mono text-xs font-normal text-muted">{s.org}</span>
                  </th>
                  <td class="px-4 py-3 align-top text-muted">{s.use}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        <div><h3 class="font-semibold">{d.data.softwareTitle}</h3><p class="mt-2 text-sm leading-relaxed text-muted">{d.data.software}</p></div>
        <div><h3 class="font-semibold">{d.data.aiTitle}</h3><p class="mt-2 text-sm leading-relaxed text-muted">{d.data.ai}</p></div>
        <div><h3 class="font-semibold">{d.data.licenseTitle}</h3><p class="mt-2 text-sm leading-relaxed text-muted">{d.data.license}</p></div>
      </div>
      <aside id="independence" class="mt-10 rounded-2xl border border-line border-l-4 border-l-earth bg-surface p-6">
        <h3 class="font-semibold">{d.data.disclaimerTitle}</h3>
        <p class="mt-2 max-w-4xl text-sm leading-relaxed text-muted">{d.data.disclaimer}</p>
      </aside>
    </div>
  </section>

  <!-- CITE: Nerfies BibTeX block -->
  <section id="cite" class="mx-auto max-w-4xl px-4 pb-20 sm:px-6">
    <p class="kicker">{d.cite.kicker}</p>
    <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight">{d.cite.title}</h2>
    <p class="mt-3 leading-relaxed text-muted">{d.cite.intro}</p>
    {
      [
        { label: d.cite.toolLabel, text: bibtex, id: 'cite-tool' },
        { label: d.cite.dataLabel, text: d.cite.dataCitation, id: 'cite-data' },
      ].map((c) => (
        <div class="mt-6">
          <div class="flex items-center justify-between gap-3">
            <h3 class="text-sm font-semibold">{c.label}</h3>
            <button type="button" class="copy-btn rounded-full border border-line px-3 py-1 text-xs hover:border-ink" data-copy={c.id} data-copied={d.cite.copied}>
              {d.cite.copy}
            </button>
          </div>
          <pre id={c.id} class="mt-2 overflow-x-auto rounded-xl bg-surface-2 p-4 font-mono text-xs leading-relaxed whitespace-pre-wrap">{c.text}</pre>
        </div>
      ))
    }
  </section>

  <!-- TEAM -->
  <section id="team" class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="kicker">{d.team.kicker}</p>
      <div class="mt-3 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="flex items-center gap-4">
          <img src="/assets/logo-vizcachas.svg" alt="" width="64" height="64" class="h-16 w-16 rounded-full border border-line bg-white p-1 dark:invert" />
          <h2 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">{d.team.title}</h2>
        </div>
        <a href={REPO_URL} class="self-start rounded-full border border-line bg-surface px-4 py-2 text-sm hover:border-ink md:self-auto">{d.team.repo} ↗</a>
      </div>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">{d.team.intro}</p>
      <ul class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 sm:gap-x-12">
        {
          team.map((name, i) => (
            <li class="flex items-baseline gap-4 border-t border-line py-5">
              <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-serif text-2xl">{name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FINAL CTA: OpenSpace "Start exploring" -->
  <section class="px-4 sm:px-6">
    <div class="band relative mx-auto max-w-4xl overflow-hidden rounded-3xl px-6 py-14 text-center ring-1 ring-white/10">
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-48 w-[80%] rounded-[50%] bg-[#6cb2ff]/20 blur-3xl"></div>
      <h2 class="relative font-serif text-3xl font-semibold text-[#eef1f7] sm:text-4xl">{d.cta.title}</h2>
      <p class="relative mt-3 text-[#a9b3c9]">{d.cta.body}</p>
      <div class="relative mt-8 flex flex-wrap justify-center gap-3 text-sm font-semibold">
        <a href={appUrl(lang)} class="rounded-full bg-sun px-5 py-2.5 text-[#0b1020] hover:brightness-95">{d.cta.app} →</a>
        <a href={REPO_URL} class="rounded-full border border-white/25 px-5 py-2.5 text-[#eef1f7] hover:border-white/60">{d.cta.repo}</a>
        <a href={localePath(lang, 'learn')} class="rounded-full border border-white/25 px-5 py-2.5 text-[#eef1f7] hover:border-white/60">{d.cta.learn}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Showcase carousel: slow continuous scroll in a seamless loop.
  // Pauses on hover, focus or touch, when off screen or in a hidden tab; disabled for reduced motion.
  const SPEED_PX_S = 30;
  const RESUME_AFTER_MS = 3000;
  const track = document.getElementById('showcase-track');
  if (track) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Width of one full copy of the slides = offset of the first card of the second copy.
    const loopWidth = () => {
      const first = track.querySelector<HTMLElement>('li[data-copy="0"]');
      const second = track.querySelector<HTMLElement>('li[data-copy="1"]');
      return first && second ? second.offsetLeft - first.offsetLeft : 0;
    };
    let hovering = false;
    let visible = true;
    let pausedUntil = 0;
    let last = 0;
    let pos = track.scrollLeft;
    const hold = (ms = RESUME_AFTER_MS) => (pausedUntil = performance.now() + ms);

    const step = (now: number) => {
      const dt = last ? Math.min(now - last, 100) : 0;
      last = now;
      const running = !reduced && visible && !hovering && !document.hidden && now > pausedUntil;
      if (running) {
        const w = loopWidth();
        pos += (SPEED_PX_S * dt) / 1000;
        if (w > 0 && pos >= w) pos -= w;
        track.scrollLeft = pos;
      } else {
        pos = track.scrollLeft; // keep in sync with manual scrolling
      }
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);

    track.addEventListener('mouseenter', () => (hovering = true));
    track.addEventListener('mouseleave', () => (hovering = false));
    track.addEventListener('focusin', () => (hovering = true));
    track.addEventListener('focusout', () => (hovering = false));
    track.addEventListener('pointerdown', () => hold());
    track.addEventListener('touchstart', () => hold(), { passive: true });
    track.addEventListener('wheel', () => hold(), { passive: true });
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(track);

    // Arrows: move one card and pause briefly.
    document.querySelectorAll<HTMLButtonElement>('[data-carousel]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = track.querySelector('li');
        if (!card) return;
        hold();
        let target = track.scrollLeft + Number(btn.dataset.carousel) * (card.clientWidth + 20);
        const w = loopWidth();
        if (w > 0 && target < 0) target += w;
        if (w > 0 && target >= w) target -= w;
        track.scrollTo({ left: target, behavior: reduced ? 'auto' : 'smooth' });
      });
    });
  }
  // Copy buttons for the citation blocks.
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const pre = document.getElementById(btn.dataset.copy ?? '');
      if (!pre) return;
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        btn.textContent = btn.dataset.copied ?? 'OK';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
      setTimeout(() => (btn.textContent = original), 1600);
    });
  });
</script>
