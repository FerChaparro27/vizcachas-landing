---
import Base from '../layouts/Base.astro';
import ConceptFigure from './ConceptFigure.astro';
import { sources } from '../data/sources';
import { t, appUrl, localePath, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);
const L = d.learn;
---

<Base lang={lang} page="learn" title={d.meta.learnTitle} description={d.meta.learnDescription}>
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-16">
      <a href={localePath(lang)} class="text-sm text-muted hover:text-ink">← {L.back}</a>
      <h1 class="mt-8 font-serif text-4xl font-semibold tracking-tight sm:text-5xl">{L.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">{L.lede}</p>
    </div>
  </section>

  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-14 sm:px-6 lg:grid-cols-[200px_1fr]">
    <aside class="hidden lg:block">
      <nav class="sticky top-24 text-sm" aria-label={L.toc}>
        <p class="kicker mb-3">{L.toc}</p>
        <ol class="space-y-2 border-l border-line">
          {L.concepts.map((c) => (
            <li><a href={`#${c.id}`} class="-ml-px block border-l border-transparent pl-3 text-muted hover:border-ink hover:text-ink">{c.title}</a></li>
          ))}
          <li><a href="#glossary" class="-ml-px block border-l border-transparent pl-3 text-muted hover:border-ink hover:text-ink">{L.glossaryTitle}</a></li>
          <li><a href="#activities" class="-ml-px block border-l border-transparent pl-3 text-muted hover:border-ink hover:text-ink">{L.activitiesTitle}</a></li>
        </ol>
      </nav>
    </aside>

    <div class="min-w-0">
      {L.concepts.map((c, i) => (
        <section id={c.id} class:list={['grid gap-8 md:grid-cols-[1.1fr_1fr] md:items-start', i > 0 && 'mt-16 border-t border-line pt-16']}>
          <div>
            <h2 class="font-serif text-2xl font-semibold sm:text-3xl">{c.title}</h2>
            {c.body.map((p) => <p class="mt-4 leading-relaxed text-muted">{p}</p>)}
            {sources[c.id] && (
              <div class="mt-6 border-t border-line pt-4">
                <p class="kicker">{L.sourcesLabel}</p>
                <ol class="mt-2 space-y-1.5 text-xs leading-relaxed text-muted">
                  {sources[c.id].map((s, n) => (
                    <li class="flex gap-2">
                      <span class="font-mono text-ink">[{n + 1}]</span>
                      <span>
                        {s.authors} ({s.year}). <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-ink underline decoration-line underline-offset-2 hover:decoration-ink"><cite class="not-italic">{s.title}</cite></a>{s.title.endsWith('.') ? '' : '.'} <i>{s.venue}</i>.
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </div>
          <figure class="rounded-lg border border-line bg-surface p-4">
            <ConceptFigure id={c.id} L={L.figLabels} />
            <figcaption class="figure-caption mt-3"><b>Fig. {i + 1}.</b> {c.figure}</figcaption>
          </figure>
        </section>
      ))}

      <section id="glossary" class="mt-20 border-t border-line pt-16">
        <h2 class="font-serif text-2xl font-semibold sm:text-3xl">{L.glossaryTitle}</h2>
        <dl class="mt-8 grid gap-x-10 gap-y-5 sm:grid-cols-2">
          {L.glossary.map((g) => (
            <div class="border-t border-line pt-3">
              <dt class="font-mono text-sm font-medium">{g.term}</dt>
              <dd class="mt-1 text-sm leading-relaxed text-muted">{g.def}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="activities" class="mt-20 border-t border-line pt-16">
        <h2 class="font-serif text-2xl font-semibold sm:text-3xl">{L.activitiesTitle}</h2>
        <p class="mt-3 text-muted">{L.activitiesIntro}</p>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {L.activities.map((a, i) => (
            <article class="flex flex-col rounded-lg border border-line bg-surface p-6">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-serif text-xl font-semibold">
                  <span class="font-mono text-sm text-muted">A{i + 1} · </span>{a.title}
                </h3>
                <span class="shrink-0 rounded-full border border-line px-2 py-0.5 font-mono text-xs text-muted">{a.level}</span>
              </div>
              <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-muted marker:font-mono marker:text-ink">
                {a.steps.map((s) => <li>{s}</li>)}
              </ol>
            </article>
          ))}
        </div>
        <a href={appUrl(lang)} target="_blank" rel="noopener noreferrer" class="mt-10 inline-block rounded bg-ink px-5 py-2.5 font-medium text-paper hover:opacity-90">
          {L.tryIt} ↗
        </a>
      </section>
    </div>
  </div>
</Base>
